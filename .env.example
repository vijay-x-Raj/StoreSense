# StoreSense AI — Environment Variables

# ── Backend ──────────────────────────────────────────────────────────
# Database: use SQLite for quick local dev, PostgreSQL for production
# SQLite (default — no setup required):
DATABASE_URL=sqlite:///./storeSense.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://storeSense:storeSense@localhost:5432/storeSense

# OpenAI API key (optional — app runs in demo mode without it)
OPENAI_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
